# Supabase — https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini — https://aistudio.google.com/apikey
# A chave NUNCA vai para o browser: só é lida nos route handlers em /api/ai/*
GEMINI_API_KEY=

# Modelo de volume: organizar inbox em lote, extrair URL.
# Flash-Lite é a linha de alta vazão — melhor para não estourar o free tier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo pesado: RAG ("perguntar ao meu cérebro") e geração de trilhas.
GEMINI_MODEL_HEAVY=gemini-3.7-flash

# Modelo de embedding. Truncado para 768 dims e normalizado L2 no servidor
# (o -001 não renormaliza sozinho quando truncado, e o índice HNSW do
# pgvector não passa de 2000 dims).
GEMINI_EMBED_MODEL=gemini-embedding-001
